# ---------- Core ----------
# Neon Postgres connection string (sslmode=require). Local dev: postgresql://postgres:postgres@localhost:5432/pawtella
DATABASE_URL=
# Set to "false" for a local Postgres without TLS. Defaults to true.
DATABASE_SSL=true
# Long random string. Required in production; the server refuses to start without it when NODE_ENV=production.
JWT_SECRET=
# Public URL of this deployment, no trailing slash (used in share links, emails, landing pages).
APP_URL=http://localhost:3000
# Deep-link scheme of the mobile app.
APP_SCHEME=pawtella
# Secret the Vercel cron scheduler sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Where admin digests and partner applications are emailed.
ADMIN_EMAIL=
# Timezone for digests and "today" calculations.
APP_TIMEZONE=America/Toronto

# ---------- Sign-in ----------
# Apple Sign-In: your iOS bundle id (audience of the identity token).
APPLE_BUNDLE_ID=
# Google Sign-In client ids that may appear as the token audience (comma-separated).
GOOGLE_CLIENT_IDS=

# ---------- AI ----------
# Claude (assistant, captions, shop assist). Missing => mock replies.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# xAI Grok Imagine (images, videos). Missing => placeholder media.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5-lite
XAI_VIDEO_MODEL_HD=grok-imagine-video-1.5

# ---------- Media (Cloudinary) ----------
# Missing => uploads are stored as data URLs in mock mode (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public id of the watermark logo uploaded to Cloudinary (e.g. pawtella/watermark).
CLOUDINARY_WATERMARK_ID=pawtella/watermark

# ---------- Shopify ----------
# e.g. pawtella.myshopify.com. Missing => mock catalog + mock checkout.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Shared secret from the webhook subscription (HMAC verification).
SHOPIFY_WEBHOOK_SECRET=
# GID of the Toronto depot location, e.g. gid://shopify/Location/1234567890
SHOPIFY_DEPOT_LOCATION_ID=

# ---------- Inventory sync (Franpos) ----------
# csv | franpos-api | octopus-bridge | mock
INVENTORY_SOURCE=mock
# Shared secret for POST /api/inventory/import
INVENTORY_IMPORT_SECRET=
FRANPOS_API_URL=
FRANPOS_API_KEY=

# ---------- Email (Resend) ----------
# Missing => emails are logged to the console.
RESEND_API_KEY=
FROM_EMAIL=Pawtella <hello@pawtella.app>
